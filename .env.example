# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Required. Generate a private secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT secret for production than for local development.
AUTH_SECRET=replace-with-a-unique-random-secret

# Required for deployments behind a proxy such as Vercel.
AUTH_TRUST_HOST=true

# Set this in Vercel's Production environment to the canonical public origin.
# Keep it unset locally; configure a preview origin separately only if needed.
# AUTH_URL=https://e-commerce-five-pink-80.vercel.app

# Server-side only. Do not prefix this value with NEXT_PUBLIC_.
ROUTE_API_BASE_URL=https://ecommerce.routemisr.com/api
